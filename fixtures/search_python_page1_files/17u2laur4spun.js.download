      query: $query
      language: $language
      period: $period
      slideshowType: $slideshowType
      sort: $sort
      first: $first
      after: $after
      rescore: $rescore
    ) {
      edges {
        node {
          ... on Slideshow {
            type
            id
            title
            thumbnail
            canonicalUrl
            user {
              login
              name
            }
            views
            totalSlides
            isSavedByCurrentUser
          }
        }
      }
      totalCount
      rescoreVariant
    }
  }
}
`,V=`query ($query: String!, $language: String, $period: Period, $slideshowType: SlideshowType, $sort: Sort, $first: Int, $after: String, $rescore: Rescore) {
