  views
  viewStats {
    views
    viewsFromEmbeds
    topEmbeds
  }
`,l=`
  ... on SlideshowLocked {
    isLocked
  }

  ... on SlideshowPrivate {
    isPrivate
    isViewable
  }

  ... on SlideshowRemoved {
    isRemoved
  }

  ... on SlideshowNotFound {
    isNotFound
  }

  ... on SlideshowRateLimited {
    isRateLimited
    message
    retryAfter
  }
`,a=`
query likes($query: SlideshowQuery!) {
  slideshow(query: $query) {
    ... on SlideshowSingle {
      likes
      isLikedByCurrentUser
    }
  }
}`,s=`
  query SlideshowByQuery($query: SlideshowQuery!, $platform: String) {
    slideshow(query: $query) {
      ... on SlideshowSingle {
        ${n}
      }

      ${l}
    }

    ${i.USER_FIELDS}
    ${t.LAYOUT_FIELDS}
  }
`,u=`
query userIsFollowing($login: String!) {
  user(login: $login) {
    isFollowing
  }
}
`,d=`
query slideshowSavedItems($query: SlideshowQuery!) {
  slideshow(query: $query) {
    ... on SlideshowSingle {
      savedItems {
        savedItemId
        savedListId
        slideNumber
      }
    }
  }
}
`,c=`
query reportCategoryTypes {
  unsafeCategoryTypes {
    id
    i18nKey
    sub_types: children {
      id
      i18nKey
    }
  }
}
